digraph ER3 {
  rankdir=LR; fontname="DejaVu Sans"; node [shape=plain, fontname="DejaVu Sans", fontsize=9]; edge [fontname="DejaVu Sans", fontsize=9, color="#555555"];
  users [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="3"><tr><td colspan="2" bgcolor="#e8e8ef"><b>users</b></td></tr>
   <tr><td align="left">PK id</td><td align="left">serial</td></tr><tr><td align="left">full_name</td><td align="left">varchar(150) NN</td></tr><tr><td align="left" bgcolor="#e6f4ea">email</td><td align="left">UQ lower(email), CHECK формат</td></tr><tr><td align="left">phone</td><td align="left">varchar(20)</td></tr><tr><td align="left">role</td><td align="left">varchar(20) CHECK</td></tr><tr><td align="left">is_active</td><td align="left">boolean</td></tr><tr><td align="left" bgcolor="#e6f4ea">password_hash</td><td align="left">varchar(255) scrypt</td></tr><tr><td align="left" bgcolor="#e6f4ea">token_version</td><td align="left">int NN</td></tr><tr><td align="left" bgcolor="#e6f4ea">last_login_at</td><td align="left">timestamptz</td></tr></table>>];
  attempts [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="3"><tr><td colspan="2" bgcolor="#e6f4ea"><b>login_attempts</b> (0002)</td></tr>
   <tr><td align="left">PK id</td><td align="left">bigserial</td></tr><tr><td align="left">email</td><td align="left">varchar(150)</td></tr><tr><td align="left">ip</td><td align="left">varchar(45)</td></tr><tr><td align="left">success</td><td align="left">boolean</td></tr><tr><td align="left">created_at</td><td align="left">timestamptz</td></tr></table>>];
  clients [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="3"><tr><td colspan="2" bgcolor="#e8e8ef"><b>clients</b></td></tr>
   <tr><td align="left">PK id</td><td align="left">serial</td></tr><tr><td align="left">name</td><td align="left">varchar(200) NN</td></tr><tr><td align="left">contact_person</td><td align="left">varchar(150)</td></tr><tr><td align="left">phone / email</td><td align="left">CHECK хотя бы одно</td></tr></table>>];
  projects [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="3"><tr><td colspan="2" bgcolor="#e8e8ef"><b>projects</b></td></tr>
   <tr><td align="left">PK id</td><td align="left">serial</td></tr><tr><td align="left">title</td><td align="left">varchar(200) NN, GIN trgm</td></tr><tr><td align="left">FK client_id</td><td align="left">int NN</td></tr><tr><td align="left">FK producer_id</td><td align="left">int</td></tr><tr><td align="left">project_type, status</td><td align="left">varchar CHECK</td></tr><tr><td align="left">budget</td><td align="left">numeric(12,2) ≥ 0</td></tr><tr><td align="left">start_date, deadline</td><td align="left">date, deadline ≥ start</td></tr><tr><td align="left">description</td><td align="left">text</td></tr><tr><td align="left">created_at / updated_at</td><td align="left">timestamptz, триггер</td></tr></table>>];
  history [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="3"><tr><td colspan="2" bgcolor="#e6f4ea"><b>project_status_history</b> (0003)</td></tr>
   <tr><td align="left">PK id</td><td align="left">bigserial</td></tr><tr><td align="left">FK project_id</td><td align="left">int NN</td></tr><tr><td align="left">old_status</td><td align="left">varchar(20)</td></tr><tr><td align="left">new_status</td><td align="left">varchar(20) NN ≠ old</td></tr><tr><td align="left">FK changed_by</td><td align="left">int</td></tr><tr><td align="left">changed_at</td><td align="left">timestamptz</td></tr><tr><td align="left">comment</td><td align="left">varchar(500)</td></tr></table>>];
  members [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="3"><tr><td colspan="2" bgcolor="#fbe9e9"><b>project_members</b></td></tr>
   <tr><td align="left">PK,FK project_id</td><td align="left">int</td></tr><tr><td align="left">PK,FK user_id</td><td align="left">int</td></tr><tr><td align="left" bgcolor="#e6f4ea">role_in_project</td><td align="left">varchar(50) CHECK не пусто</td></tr></table>>];
  tasks [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="3"><tr><td colspan="2" bgcolor="#e8e8ef"><b>tasks</b></td></tr>
   <tr><td align="left">PK id</td><td align="left">serial</td></tr><tr><td align="left">FK project_id</td><td align="left">int NN</td></tr><tr><td align="left">title</td><td align="left">varchar(200) NN</td></tr><tr><td align="left" bgcolor="#e6f4ea">description</td><td align="left">text</td></tr><tr><td align="left">stage, status</td><td align="left">varchar CHECK</td></tr><tr><td align="left">FK assignee_id</td><td align="left">int</td></tr><tr><td align="left">due_date</td><td align="left">date</td></tr><tr><td align="left" bgcolor="#e6f4ea">updated_at</td><td align="left">timestamptz, триггер</td></tr></table>>];
  equipment [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="3"><tr><td colspan="2" bgcolor="#e8e8ef"><b>equipment</b></td></tr>
   <tr><td align="left">PK id</td><td align="left">serial</td></tr><tr><td align="left">name, category</td><td align="left">varchar</td></tr><tr><td align="left">inventory_number</td><td align="left">UQ</td></tr><tr><td align="left">is_available</td><td align="left">boolean</td></tr></table>>];
  bookings [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="3"><tr><td colspan="2" bgcolor="#fbe9e9"><b>equipment_bookings</b></td></tr>
   <tr><td align="left">PK id</td><td align="left">serial</td></tr><tr><td align="left">FK equipment_id</td><td align="left">int NN</td></tr><tr><td align="left">FK project_id</td><td align="left">int NN</td></tr><tr><td align="left">starts_at, ends_at</td><td align="left">timestamptz, ends &gt; starts</td></tr><tr><td colspan="2" align="left">EXCLUDE gist: нет пересечений</td></tr></table>>];
  journal [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="3"><tr><td colspan="2" bgcolor="#fff1d6"><b>schema_migrations</b></td></tr>
   <tr><td align="left">PK version</td><td align="left">varchar(4)</td></tr><tr><td align="left">name</td><td align="left">varchar(200)</td></tr><tr><td align="left">checksum</td><td align="left">char(64) SHA-256</td></tr><tr><td align="left">applied_at</td><td align="left">timestamptz</td></tr><tr><td align="left">execution_ms</td><td align="left">int</td></tr></table>>];
  view [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="3"><tr><td bgcolor="#e6f4ea"><b>v_user_workload</b> (0004, VIEW)</td></tr><tr><td align="left">open_tasks, in_progress,<br/>overdue, projects</td></tr></table>>];
  clients -> projects [label="1:N RESTRICT"];
  users -> projects [label="1:N продюсер"];
  projects -> members [label="1:N CASCADE"]; users -> members [label="1:N"];
  projects -> tasks [label="1:N CASCADE"]; users -> tasks [label="1:N исполнитель"];
  projects -> history [label="1:N CASCADE"]; users -> history [label="1:N SET NULL"];
  equipment -> bookings [label="1:N RESTRICT"]; projects -> bookings [label="1:N CASCADE"];
  users -> view [style=dotted, arrowhead=none]; tasks -> view [style=dotted, arrowhead=none];
  attempts -> users [style=dotted, arrowhead=none, label="по email"];
}
