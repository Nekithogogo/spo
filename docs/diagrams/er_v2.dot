digraph ER2 {
  rankdir=LR; fontname="DejaVu Sans"; node [shape=plain, fontname="DejaVu Sans", fontsize=9]; edge [fontname="DejaVu Sans", fontsize=9, color="#555555"];
  users [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="3"><tr><td colspan="2" bgcolor="#e8e8ef"><b>users</b></td></tr>
   <tr><td align="left">PK id</td><td align="left">serial</td></tr><tr><td align="left">full_name</td><td align="left">varchar(150) NN</td></tr><tr><td align="left">email</td><td align="left">varchar(150) NN UQ</td></tr><tr><td align="left">phone</td><td align="left">varchar(20)</td></tr><tr><td align="left">role</td><td align="left">varchar(20) CHECK</td></tr><tr><td align="left">is_active</td><td align="left">boolean</td></tr><tr><td align="left">created_at</td><td align="left">timestamptz</td></tr></table>>];
  clients [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="3"><tr><td colspan="2" bgcolor="#e8e8ef"><b>clients</b></td></tr>
   <tr><td align="left">PK id</td><td align="left">serial</td></tr><tr><td align="left">name</td><td align="left">varchar(200) NN</td></tr><tr><td align="left">contact_person</td><td align="left">varchar(150)</td></tr><tr><td align="left">phone</td><td align="left">varchar(20)</td></tr><tr><td align="left">email</td><td align="left">varchar(150)</td></tr><tr><td align="left">created_at</td><td align="left">timestamptz</td></tr></table>>];
  projects [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="3"><tr><td colspan="2" bgcolor="#e8e8ef"><b>projects</b></td></tr>
   <tr><td align="left">PK id</td><td align="left">serial</td></tr><tr><td align="left">title</td><td align="left">varchar(200) NN</td></tr><tr><td align="left">FK client_id</td><td align="left">int NN</td></tr><tr><td align="left" bgcolor="#e6f4ea">FK producer_id</td><td align="left">int</td></tr><tr><td align="left">project_type</td><td align="left">varchar(30) CHECK</td></tr><tr><td align="left">status</td><td align="left">varchar(20) CHECK</td></tr><tr><td align="left">budget</td><td align="left">numeric(12,2) ≥ 0</td></tr><tr><td align="left">start_date</td><td align="left">date</td></tr><tr><td align="left">deadline</td><td align="left">date ≥ start</td></tr><tr><td align="left">description</td><td align="left">text</td></tr><tr><td align="left" bgcolor="#e6f4ea">created_at / updated_at</td><td align="left">timestamptz</td></tr></table>>];
  members [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="3"><tr><td colspan="2" bgcolor="#fbe9e9"><b>project_members</b></td></tr>
   <tr><td align="left">PK,FK project_id</td><td align="left">int</td></tr><tr><td align="left">PK,FK user_id</td><td align="left">int</td></tr><tr><td align="left">role_in_project</td><td align="left">varchar(50) NN</td></tr></table>>];
  tasks [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="3"><tr><td colspan="2" bgcolor="#e8e8ef"><b>tasks</b></td></tr>
   <tr><td align="left">PK id</td><td align="left">serial</td></tr><tr><td align="left">FK project_id</td><td align="left">int NN</td></tr><tr><td align="left">title</td><td align="left">varchar(200) NN</td></tr><tr><td align="left" bgcolor="#e6f4ea">stage</td><td align="left">varchar(20) CHECK</td></tr><tr><td align="left">status</td><td align="left">varchar(20) CHECK</td></tr><tr><td align="left">FK assignee_id</td><td align="left">int</td></tr><tr><td align="left">due_date</td><td align="left">date</td></tr><tr><td align="left">created_at</td><td align="left">timestamptz</td></tr></table>>];
  equipment [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="3"><tr><td colspan="2" bgcolor="#e8e8ef"><b>equipment</b></td></tr>
   <tr><td align="left">PK id</td><td align="left">serial</td></tr><tr><td align="left">name</td><td align="left">varchar(150) NN</td></tr><tr><td align="left">category</td><td align="left">varchar(20) CHECK</td></tr><tr><td align="left">inventory_number</td><td align="left">varchar(30) NN UQ</td></tr><tr><td align="left">is_available</td><td align="left">boolean</td></tr></table>>];
  bookings [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="3"><tr><td colspan="2" bgcolor="#fbe9e9"><b>equipment_bookings</b></td></tr>
   <tr><td align="left">PK id</td><td align="left">serial</td></tr><tr><td align="left">FK equipment_id</td><td align="left">int NN</td></tr><tr><td align="left">FK project_id</td><td align="left">int NN</td></tr><tr><td align="left" bgcolor="#e6f4ea">starts_at</td><td align="left">timestamptz NN</td></tr><tr><td align="left" bgcolor="#e6f4ea">ends_at</td><td align="left">timestamptz &gt; starts_at</td></tr><tr><td colspan="2" align="left" bgcolor="#e6f4ea">EXCLUDE: нет пересечений по одной единице</td></tr></table>>];
  clients -> projects [label="1:N\nRESTRICT"];
  users -> projects [label="1:N продюсер\nSET NULL"];
  projects -> members [label="1:N CASCADE"]; users -> members [label="1:N"];
  projects -> tasks [label="1:N CASCADE"]; users -> tasks [label="1:N исполнитель\nSET NULL"];
  equipment -> bookings [label="1:N RESTRICT"]; projects -> bookings [label="1:N CASCADE"];
}
