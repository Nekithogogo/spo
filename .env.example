# Скопируйте в .env (chmod 600) и задайте свои значения. Файл .env в git не попадает.
APP_VERSION=2.0.0
POSTGRES_DB=studio
POSTGRES_USER=studio_owner
POSTGRES_PASSWORD=change-me-owner
APP_DB_PASSWORD=change-me-app
SECRET_KEY=change-me-secret
# Если задан, /api/metrics требует заголовок Authorization: Bearer <токен> (снаружи метрики закрыты nginx)
METRICS_TOKEN=
LOG_LEVEL=INFO
# На сервере: HTTP_BIND=0.0.0.0, HTTP_PORT=80, HTTPS_PORT=443
HTTP_BIND=127.0.0.1
HTTP_PORT=8080
HTTPS_PORT=8443
# --seed загружает демонстрационные данные в пустую БД; на рабочем сервере поставьте --no-seed
SEED_FLAG=--seed
# Адрес для оповещений monitor.sh (например, вебхук чата); пусто — только системный журнал
ALERT_WEBHOOK=
# Учётная запись, под которой release.sh/restore.sh выполняют smoke-тест после выпуска
SMOKE_EMAIL=orlova@studio.local
SMOKE_PASSWORD=studio2026
